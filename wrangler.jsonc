{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bbb-ui",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "ui.beepboopbit.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./.release/site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
